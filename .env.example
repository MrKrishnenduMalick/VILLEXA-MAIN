# =====================================================================
# VILLEXA / DIGITAL SHOWROOM — CLIENT ENVIRONMENT CONFIGURATION
# =====================================================================
# This file is a template. Copy it to .env.local for local development,
# or set these variables in your deployment platform (Vercel, Netlify, Cloudflare).
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit .env or .env.local to Git.
# 2. NEVER put your Supabase service_role key here.
#    Only the public anon key (VITE_SUPABASE_ANON_KEY) is safe for client code.
# =====================================================================

# ---------------------------------------------------------------------
# 1. DEDICATED CLIENT BACKEND (SUPABASE)
# ---------------------------------------------------------------------
# Each client installation must have its own isolated Supabase project.
# Leave blank to run the showroom in offline local development mode.
VITE_SUPABASE_URL=https://skpadbzwtprsuizvpyrd.supabase.co
VITE_SUPABASE_ANON_KEY=your_actual_public_key

# ---------------------------------------------------------------------
# 2. CLIENT BRAND IDENTITY (OPTIONAL OVERRIDES)
# ---------------------------------------------------------------------
# If not provided, defaults to the master baseline preset (Villexa).
# You can also edit src/config/clientConfig.ts directly.
VITE_CLIENT_BRAND_NAME=VILLEXA
VITE_CLIENT_TAGLINE=Haute Ébénisterie & Architecture
VITE_CLIENT_BADGE=MILANO • EST. 2026
VITE_CLIENT_DESCRIPTION=Editorial digital showroom for architectural furniture and bespoke commissions.
VITE_CLIENT_LOGO_TEXT=VILLEXA
VITE_CLIENT_LOGO_SUBTEXT=EDIZIONI ARCHITETTONICHE
# VITE_CLIENT_LOGO_IMAGE_URL=/brand/client-logo.svg
# VITE_CLIENT_FAVICON_URL=/favicon.svg

# ---------------------------------------------------------------------
# 3. CLIENT CONTACT & CONCIERGE (OPTIONAL OVERRIDES)
# ---------------------------------------------------------------------
VITE_CLIENT_CONTACT_EMAIL=concierge@villexa.com
VITE_CLIENT_CONTACT_PHONE=+1 (800) 482-1980
VITE_CLIENT_WHATSAPP_NUMBER=18004821980
VITE_CLIENT_WHATSAPP_MESSAGE=Hello, I would like to inquire about an architectural furniture piece from your showroom.
VITE_CLIENT_SHOWROOM_ADDRESS=Via della Spiga 28, 20121 Milano, Italy
VITE_CLIENT_VISITING_HOURS=Monday – Saturday: 10:00 to 19:00 (By Appointment Only)
VITE_CLIENT_LOCATION_NAME=Milano Flagship Atelier

# ---------------------------------------------------------------------
# 4. SOCIAL MEDIA LINKS (OPTIONAL OVERRIDES)
# ---------------------------------------------------------------------
VITE_CLIENT_INSTAGRAM_URL=https://instagram.com/villexaofficial
VITE_CLIENT_PINTEREST_URL=https://pinterest.com/villexaofficial
VITE_CLIENT_LINKEDIN_URL=https://linkedin.com/company/villexa
# VITE_CLIENT_TWITTER_URL=https://x.com/villexa

# ---------------------------------------------------------------------
# 5. LUXURY THEME TOKENS (HEX COLOR CODES)
# ---------------------------------------------------------------------
VITE_CLIENT_THEME_ACCENT=#d4af37
VITE_CLIENT_THEME_ACCENT_HOVER=#c5a059
VITE_CLIENT_THEME_BG_PRIMARY=#f6f3ee
VITE_CLIENT_THEME_BG_DARK=#141413

# ---------------------------------------------------------------------
# 6. FEATURE AVAILABILITY FLAGS (true / false)
# ---------------------------------------------------------------------
# Configure which showroom modules are enabled for this client.
VITE_FEATURE_3D_VIEWER=true
VITE_FEATURE_360_TURNTABLE=true
VITE_FEATURE_SHOWROOM_VIDEO=false
VITE_FEATURE_BESPOKE_INQUIRY=true
VITE_FEATURE_PRICE_DISPLAY=true
VITE_FEATURE_COLLECTIONS=true
VITE_FEATURE_INSPIRATION=true
VITE_FEATURE_CRAFTSMANSHIP=true

# ---------------------------------------------------------------------
# 7. SEO & DEPLOYMENT METADATA
# ---------------------------------------------------------------------
VITE_CLIENT_SEO_TITLE=VILLEXA — Haute Ébénisterie & Architecture | Modern Showroom
VITE_CLIENT_SEO_DESC=Villexa curates timeless interior masterworks. Sculptural silhouettes, organic materials, and deliberate proportions crafted for refined living spaces.
VITE_CLIENT_SITE_URL=https://villexa.com
